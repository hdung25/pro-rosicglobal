# Public business contacts. Fill only with verified details.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ZALO=

# Server-only quote delivery. Never prefix these values with VITE_ and never
# commit a filled .env file. Configure the same values in Vercel Production.
# Make receives the normalized quote payload and can fan out to internal tools.
MAKE_QUOTE_WEBHOOK_URL=
# Optional HMAC SHA-256 signature sent as X-Quote-Signature.
MAKE_QUOTE_WEBHOOK_SECRET=

# Resend transactional email. RESEND_FROM_EMAIL must use a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# One or more internal recipients, separated by commas or semicolons.
SALES_NOTIFICATION_EMAIL=
# Optional reply address shown on the automatic customer acknowledgement.
RESEND_REPLY_TO_EMAIL=

# Optional public HTTPS URL. Without it, email renders a non-clickable
# "Download Our Catalog/Profile" placeholder instead of a broken link.
CATALOG_PROFILE_URL=

# Best-effort per-instance guard. Use Vercel WAF / an external store for a
# distributed rate limit if traffic volume requires it.
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_SECONDS=600
